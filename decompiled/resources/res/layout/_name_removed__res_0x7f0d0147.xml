<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/parentPanel"
    android:background="?attr/_name_removed__res_0x7f040036"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/topImage"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/topPanel"
        android:paddingLeft="@dimen/_name_removed__res_0x7f070011"
        android:paddingTop="@dimen/_name_removed__res_0x7f070011"
        android:paddingRight="@dimen/_name_removed__res_0x7f070011"
        android:paddingBottom="0dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.facebook.resources.ui.FbTextView
            android:ellipsize="end"
            android:id="@+id/alertTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:accessibilityHeading="true"
            style="?attr/_name_removed__res_0x7f040042"/>
    </LinearLayout>
    <FrameLayout
        android:orientation="vertical"
        android:id="@+id/contentPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:minHeight="48dp"
        android:layout_weight="1">
        <View
            android:layout_gravity="top"
            android:id="@+id/scrollIndicatorUp"
            android:background="?attr/_name_removed__res_0x7f040043"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <ScrollView
            android:id="@+id/scrollView"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/scroll_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.facebook.resources.ui.FbTextView
                    android:id="@+id/message"
                    android:paddingLeft="@dimen/_name_removed__res_0x7f070011"
                    android:paddingTop="@dimen/_name_removed__res_0x7f07001b"
                    android:paddingRight="@dimen/_name_removed__res_0x7f070011"
                    android:paddingBottom="0dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="?attr/_name_removed__res_0x7f04003e"/>
                <com.facebook.resources.ui.FbTextView
                    android:id="@+id/disclaimer"
                    android:paddingLeft="@dimen/_name_removed__res_0x7f070011"
                    android:paddingTop="@dimen/_name_removed__res_0x7f07001b"
                    android:paddingRight="@dimen/_name_removed__res_0x7f070011"
                    android:paddingBottom="0dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="?attr/_name_removed__res_0x7f04003b"/>
                <View
                    android:id="@+id/textSpacerNoButtons"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_name_removed__res_0x7f070011"/>
            </LinearLayout>
        </ScrollView>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/scrollIndicatorDown"
            android:background="@drawable/fbui_divider_horizontal"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/customPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_weight="1">
        <FrameLayout
            android:id="@+id/custom"
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/buttonPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.facebook.fbui.dialog.DialogButtonBar
            android:id="@+id/buttonBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="?attr/_name_removed__res_0x7f040037">
            <com.facebook.resources.ui.FbButton
                android:id="@+id/button3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="?attr/_name_removed__res_0x7f040039"/>
            <com.facebook.resources.ui.FbButton
                android:id="@+id/button2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="?attr/_name_removed__res_0x7f040039"/>
            <com.facebook.resources.ui.FbButton
                android:id="@+id/button1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="?attr/_name_removed__res_0x7f04003f"/>
        </com.facebook.fbui.dialog.DialogButtonBar>
    </LinearLayout>
</LinearLayout>
