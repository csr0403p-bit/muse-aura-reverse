<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fbui="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="left"
        android:id="@+id/fbui_tooltip_wrapper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="?attr/_name_removed__res_0x7f0405b4">
        <com.facebook.fbui.widget.layout.ImageBlockLayout
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/fbui_tooltip_background"
            android:background="?attr/_name_removed__res_0x7f0405af"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            fbui:NOT_FOUND_0x9="0x11"
            style="?attr/_name_removed__res_0x7f0405b0">
            <com.facebook.resources.ui.FbTextView
                android:id="@+id/fbui_tooltip_title"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="?attr/_name_removed__res_0x7f0405b8"/>
            <com.facebook.resources.ui.FbTextView
                android:id="@+id/fbui_tooltip_description"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="?attr/_name_removed__res_0x7f0405b1"/>
        </com.facebook.fbui.widget.layout.ImageBlockLayout>
    </FrameLayout>
    <ImageView
        android:layout_gravity="top"
        android:id="@+id/fbui_tooltip_nub_below"
        android:visibility="invisible"
        android:layout_width="24dp"
        android:layout_height="12dp"
        android:src="?attr/_name_removed__res_0x7f0405b6"/>
    <ImageView
        android:layout_gravity="bottom"
        android:id="@+id/fbui_tooltip_nub_above"
        android:visibility="invisible"
        android:layout_width="24dp"
        android:layout_height="16dp"
        android:src="?attr/_name_removed__res_0x7f0405b5"/>
    <ImageView
        android:layout_gravity="start"
        android:id="@+id/fbui_tooltip_nub_right"
        android:visibility="invisible"
        android:layout_width="24dp"
        android:layout_height="16dp"
        android:src="?attr/_name_removed__res_0x7f0405b6"/>
</FrameLayout>
