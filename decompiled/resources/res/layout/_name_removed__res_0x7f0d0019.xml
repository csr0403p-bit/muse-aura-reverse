<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/widget_preview_background"
    android:paddingTop="18dp"
    android:paddingBottom="17dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:clipToOutline="true">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/aura_default_avatar"
            android:importantForAccessibility="no"/>
        <TextView
            android:textSize="20sp"
            android:textColor="@color/_name_removed__res_0x7f0600da"
            android:ellipsize="end"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/_name_removed__res_0x7f12016d"
            android:maxLines="1"
            android:layout_weight="1"
            android:fontFamily="@font/optimistic_ai_vf"
            android:layout_marginStart="12dp"/>
        <ImageView
            android:background="@drawable/widget_preview_button_background"
            android:padding="10dp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/microphone_wght400_outline_24"
            android:tint="@color/_name_removed__res_0x7f0600da"
            android:contentDescription="@string/_name_removed__res_0x7f12016a"/>
        <ImageView
            android:background="@drawable/widget_preview_button_background"
            android:padding="10dp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/compose_wght400_outline_24"
            android:tint="@color/_name_removed__res_0x7f0600da"
            android:contentDescription="@string/_name_removed__res_0x7f12016c"
            android:layout_marginStart="12dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:background="@drawable/ask_bar_widget_preview_tabs_background"
        android:layout_width="match_parent"
        android:layout_height="61dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <ImageView
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:src="@drawable/aura_tab_chat_outline_24"
            android:tint="@color/_name_removed__res_0x7f0600da"
            android:layout_weight="1"
            android:importantForAccessibility="no"/>
        <ImageView
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:src="@drawable/aura_tab_feed_outline_24"
            android:tint="@color/_name_removed__res_0x7f0600da"
            android:layout_weight="1"
            android:importantForAccessibility="no"/>
        <ImageView
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:src="@drawable/aura_tab_ideas_outline_24"
            android:tint="@color/_name_removed__res_0x7f0600da"
            android:layout_weight="1"
            android:importantForAccessibility="no"/>
        <ImageView
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:src="@drawable/aura_tab_goals_outline_24"
            android:tint="@color/_name_removed__res_0x7f0600da"
            android:layout_weight="1"
            android:importantForAccessibility="no"/>
        <ImageView
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:src="@drawable/aura_tab_library_outline_24"
            android:tint="@color/_name_removed__res_0x7f0600da"
            android:layout_weight="1"
            android:importantForAccessibility="no"/>
    </LinearLayout>
</FrameLayout>
