<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/month_navigation_bar"
    android:paddingTop="@dimen/_name_removed__res_0x7f070004"
    android:paddingBottom="@dimen/_name_removed__res_0x7f070004"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <com.google.android.material.button.MaterialButton
            android:gravity="start|center_vertical"
            android:layout_gravity="start"
            android:id="@+id/month_navigation_fragment_toggle"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_name_removed__res_0x7f070007"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:NOT_FOUND_0xc="@drawable/material_ic_menu_arrow_down_black_24dp"
            app:NOT_FOUND_0xd="0x4"
            app:NOT_FOUND_0xe="4dp"
            style="?attr/_name_removed__res_0x7f0403c5"/>
    </FrameLayout>
    <com.google.android.material.button.MaterialButton
        android:gravity="center"
        android:id="@+id/month_navigation_previous"
        android:layout_width="@dimen/_name_removed__res_0x7f070007"
        android:layout_height="@dimen/_name_removed__res_0x7f070007"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:contentDescription="@string/_name_removed__res_0x7f120cfd"
        app:NOT_FOUND_0xc="@drawable/material_ic_keyboard_arrow_previous_black_24dp"
        style="?attr/_name_removed__res_0x7f0403c3"/>
    <com.google.android.material.button.MaterialButton
        android:gravity="center"
        android:id="@+id/month_navigation_next"
        android:layout_width="@dimen/_name_removed__res_0x7f070007"
        android:layout_height="@dimen/_name_removed__res_0x7f070007"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:contentDescription="@string/_name_removed__res_0x7f120cfc"
        app:NOT_FOUND_0xc="@drawable/material_ic_keyboard_arrow_next_black_24dp"
        style="?attr/_name_removed__res_0x7f0403c3"/>
</LinearLayout>
